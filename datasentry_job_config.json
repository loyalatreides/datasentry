{
    "name": "DataSentry Pipeline",
    "description": "End-to-end ELT data quality pipeline for financial data. Orchestrates Bronze ingestion, Silver validation, remediation, Gold scoring and exception reporting in sequence.",
    "tasks": [
        {
            "task_key": "bronze_ingestion",
            "description": "Discover CSV files in the Unity Catalog Volume, skip files already ingested, append to Bronze Delta tables and reconcile source rows against landed rows.",
            "notebook_task": {
                "notebook_path": "/Workspace/Users/kamranhabib1212@gmail.com/datasentry/notebooks/02_bronze_ingestion",
                "source": "WORKSPACE"
            },
            "environment_key": "serverless"
        },
        {
            "task_key": "silver_validation",
            "description": "Cast types safely and apply 43 rule checks across Completeness, Validity, Consistency, Uniqueness and Referential Integrity. Tag each record PASS or FAIL.",
            "depends_on": [
                {
                    "task_key": "bronze_ingestion"
                }
            ],
            "notebook_task": {
                "notebook_path": "/Workspace/Users/kamranhabib1212@gmail.com/datasentry/notebooks/03_silver_validation",
                "source": "WORKSPACE"
            },
            "environment_key": "serverless"
        },
        {
            "task_key": "remediation",
            "description": "Route failed records to AUTO_FIX, QUARANTINE or ESCALATE, apply and re-check safe fixes, write silver_remediated tables and before/after statistics.",
            "depends_on": [
                {
                    "task_key": "silver_validation"
                }
            ],
            "notebook_task": {
                "notebook_path": "/Workspace/Users/kamranhabib1212@gmail.com/datasentry/notebooks/06_remediation",
                "source": "WORKSPACE"
            },
            "environment_key": "serverless"
        },
        {
            "task_key": "gold_task",
            "description": "Score full Silver at rule, dimension and table level and assign GREEN/AMBER/RED health status.",
            "depends_on": [
                {
                    "task_key": "remediation"
                }
            ],
            "notebook_task": {
                "notebook_path": "/Workspace/Users/kamranhabib1212@gmail.com/datasentry/notebooks/04_gold_scoring",
                "source": "WORKSPACE"
            },
            "environment_key": "serverless"
        },
        {
            "task_key": "exception_reporting",
            "description": "Write a unified exception log of all failed Silver records with HIGH/MEDIUM/LOW severity.",
            "depends_on": [
                {
                    "task_key": "gold_task"
                }
            ],
            "notebook_task": {
                "notebook_path": "/Workspace/Users/kamranhabib1212@gmail.com/datasentry/notebooks/05_exception_reporting",
                "source": "WORKSPACE"
            },
            "environment_key": "serverless"
        }
    ],
    "environments": [
        {
            "environment_key": "serverless",
            "spec": {
                "client": "1"
            }
        }
    ],
    "run_as": {
        "user_name": "kamranhabib1212@gmail.com"
    },
    "max_concurrent_runs": 1,
    "tags": {
        "project": "datasentry",
        "layer": "pipeline",
        "env": "dev"
    }
}